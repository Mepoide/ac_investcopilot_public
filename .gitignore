# Secrets (never commit)
.env
*.env
!*.env.example
# Service Account keys (credenciales GCP, nunca versionar)
*-sa-key.json
*serviceaccount*.json
*service-account*.json

# Windows download metadata
*Zone.Identifier

# Large source zip (keep extracted folder instead)
InvestCopilot_AI_Summit.zip

# Python
__pycache__/
*.pyc

# Estado en vivo del orquestador (progreso de la ejecución actual, no histórico)
run_*_progress.json
# Log del subproceso del orquestador lanzado desde la web (regenerable)
08_agents_mcp/orchestrator/run_*.log

# Outputs de ejecuciones (TEST y DEC_*) — logs de decisiones, no código
# Los outputs se regeneran bajo demanda; no tiene sentido versionarlos
02_research/outputs_research/TEST_*
02_research/outputs_research/DEC_*
03_macro_houseview/outputs_macro/TEST_*
03_macro_houseview/outputs_macro/DEC_*
