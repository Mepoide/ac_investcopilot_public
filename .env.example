# Copia este archivo a .env (en la raíz del repo) y rellena tus valores.
# .env NUNCA se commitea (ver .gitignore). Solo para desarrollo local.
# En cloud, estas credenciales deben venir de un gestor de secretos
# (Key Vault / Workload Identity), no de un archivo .env.

# Modo de workflow del orquestador: script | llm
INVESTCOPILOT_WORKFLOW_MODE=llm

# Modo de LLM: mock | openai_compatible | azure_openai | vertex_ai
INVESTCOPILOT_LLM_MODE=vertex_ai

# --- Vertex AI (Google Cloud / Gemini) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# gemini-2.5-flash: agentes de dominio (macro, riesgo, mandatos) — rápido/barato, buen tool calling
# gemini-2.5-pro: recomendado para el agente de Síntesis/Comité Virtual (razonamiento cruzado)
GOOGLE_VERTEX_MODEL=gemini-2.5-flash
# Opcional: modelo distinto solo para el paso de síntesis del orquestador.
# GOOGLE_VERTEX_MODEL_SYNTHESIS=gemini-2.5-pro
# Opcional: activa "thinking" de Gemini 2.5 (desactivado por defecto, ver llm_client.py).
# GOOGLE_THINKING_BUDGET=1024
# Normalmente NO hace falta fijar esto: si lo dejas vacío, llm_client.py
# obtiene y cachea automáticamente un access token ejecutando
#   gcloud auth application-default print-access-token
# (requiere haber hecho una vez 'gcloud auth application-default login').
# Solo fíjalo a mano si quieres forzar un token concreto (CI, etc.) o no
# tienes gcloud disponible. En cloud no se usa ninguna de las dos cosas:
# se sustituye por Workload Identity / Service Account.
# GOOGLE_ACCESS_TOKEN=

# --- Despliegue en servidor (DC Windows) sin gcloud: Service Account key ---
# En un servidor sin gcloud CLI (p.ej. el DC de Mapfre), la auth a Vertex AI
# se hace con una Service Account key JSON. llm_client.py hace fallback a la
# librería google.auth, que recoge automáticamente esta variable.
# La SA necesita rol roles/aiplatform.user. El JSON está gitignored (*-sa-key.json).
# GOOGLE_APPLICATION_CREDENTIALS=E:\ruta\al\investcopilot-sa-key.json

# --- Proxy corporativo (solo servidores sin salida directa a internet) ---
# En el DC, el tráfico HTTPS saliente DEBE ir por el proxy corporativo; las
# conexiones directas se rechazan (WinError 10061 a oauth2.googleapis.com).
# _load_dotenv() vuelca TODA clave del .env a os.environ, así que requests/urllib
# recogen estas variables de proxy automáticamente. Sin ellas, la auth falla
# aunque la SA key cargue bien. En local/WSL NO hacen falta (déjalas comentadas).
# HTTPS_PROXY=http://proxy.corporativo:PUERTO
# HTTP_PROXY=http://proxy.corporativo:PUERTO
# NO_PROXY=localhost,127.0.0.1

# --- Google Search (Research Agent) ---
# El Research Agent usa Google Search grounding NATIVO de Gemini 2.x en Vertex AI.
# No requiere API key separada ni Programmable Search Engine (PSE).
# La búsqueda se realiza automáticamente con la misma auth de Vertex AI (ADC).
# Las siguientes vars NO son necesarias con el modo grounding actual:
# GOOGLE_SEARCH_API_KEY=   # solo necesaria si se vuelve a Custom Search API
# GOOGLE_SEARCH_CX=        # solo necesaria si se vuelve a Custom Search API

# --- Control de costes (cost_tracker.py) ---
# Cap duro diario en EUR (1 USD ≈ 1 EUR a efectos de prototipo).
# Cuando se alcanza, las llamadas LLM se bloquean hasta el día siguiente UTC.
# ~5 EUR = ~100-150 runs completos con Flash; ~15 runs con Pro en síntesis.
COST_CAP_DAILY_EUR=5.0
# Umbral de alerta (log WARN, no bloquea): avisa cuando se acerca al cap.
COST_CAP_WARN_EUR=3.0
# Cap duro de queries a Google Search API por día (F2 Research).
# Las primeras 100/día son gratis en Custom Search; este cap es conservador.
SEARCH_CAP_DAILY=100

# --- Azure OpenAI (alternativa, no usada por ahora) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<nombre-del-deployment>
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
